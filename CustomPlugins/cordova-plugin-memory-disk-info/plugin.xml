<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-memory-disk-info"
        version="1.0.0">
    <name>MemoryDiskInfoPlugin</name>
    <description>Disk Space and Memory Info</description>
    <license>MIT</license>
    <keywords>diskSpace,memory</keywords>
    
    <js-module src="diskSpace.js" name="DiskSpacePlugin">
        <clobbers target="DiskSpacePlugin"/>
    </js-module>

    <!-- Android -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="MemoryInfoPlugin">
                <param name="android-package" value="com.primeroedge.diskSpace.MemoryInfoPlugin"/>
                <param name="onload" value="true"/>
            </feature>
            <feature name="DiskSpacePlugin">
                <param name="android-package" value="com.primeroedge.diskSpace.DiskSpacePlugin"/>
                <param name="onload" value="true"/>
            </feature>
        </config-file>
        <source-file src="src/android/MemoryInfoPlugin.java" target-dir="src/com/primeroedge/diskSpace/"/>
        <source-file src="src/android/DiskSpacePlugin.java" target-dir="src/com/primeroedge/diskSpace/"/>
    </platform>

    <!-- iOS -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="MemoryInfoPlugin">
                <param name="ios-package" value="MemoryInfoPlugin"/>
                <param name="onload" value="true"/>
            </feature>
            <feature name="DiskSpacePlugin">
                <param name="ios-package" value="DiskSpacePlugin"/>
                <param name="onload" value="true"/>
            </feature>
        </config-file>
        <source-file src="src/ios/MemoryInfoPlugin.m" />
        <source-file src="src/ios/DiskSpacePlugin.m" />
    </platform>
</plugin>
