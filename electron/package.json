{
  "name": "ExpressPoint",
  "productName": "ExpressPoint",
  "description": "Point Of Service, Powered by PrimeroEdge",
  "author": "Cybersoft Technologies Inc",
  "version": "2.2.14",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron-webpack dev",
    "copy-www": "cpx ../www/**/* src/renderer",
    "build": "yarn copy-www && tsc && electron-builder build -w",
    "build-windows": "electron-builder build -w ",
    "tsc": "tsc"
  },
  "build": {
    "appId": "com.primeroedge.expresspoint",
    "extends": null,
    "files": [
      "src/**/*",
      "package.json",
      "Peripherals/**/*",
      "build/**/*",
      "references/**/*"
    ],
    "win": {
      "asar": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "http://localhost/squirrel/"
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "include": "build/installer.nsh",
      "installerHeaderIcon": "build/icon.ico",
      "packElevateHelper": true
    }
  },
  "dependencies": {
    "electron-browser-storage": "^1.0.7",
    "@trodi/electron-splashscreen": "^1.0.0",
    "electron-log": "^4.3.1",
    "electron-updater": "^4.3.5",
    "machine-uuid": "^1.2.0",
    "net": "^1.0.2",
    "os": "^0.1.1",
    "source-map-support": "^0.5.19",
    "systeminformation": "^4.23.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/semver": "^6.0.0",
    "angular2-template-loader": "^0.6.2",
    "cpx": "^1.5.0",
    "electron": "11.2.0",
    "electron-builder": "^22.9.1",
    "electron-builder-squirrel-windows": "^22.10.4",
    "electron-rebuild": "^2.3.4",
    "electron-webpack": "^2.8.2",
    "electron-webpack-ts": "^4.0.1",
    "typescript": "^3.4.1",
    "webpack": "^5.17.0"
  },
  "electronWebpack": {
    "renderer": {
      "sourceDirectory": null
    }
  }
}
