{
  "extends": "./node_modules/electron-webpack/tsconfig-base.json",
  "compileOnSave": true,
  "compilerOptions": {
      "target": "es2015",
      "module": "commonjs",
      "moduleResolution": "node",
      "noUnusedLocals": false,
      "skipLibCheck": true,
      "sourceMap": true
  },
  "include": [
    "./**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
